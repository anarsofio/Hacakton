{
  "name": "caseflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "host": "npm run build && next start -H 0.0.0.0 -p 3000",
    "host:dev": "next dev -H 0.0.0.0 -p 3000",
    "tunnel": "node scripts/tunnel.mjs",
    "public": "concurrently -k -n next,tunnel -c cyan,magenta \"npm run host:dev\" \"npm run tunnel\"",
    "public:prod": "npm run build && concurrently -k -n next,tunnel -c cyan,magenta \"next start -H 0.0.0.0 -p 3000\" \"npm run tunnel\"",
    "lint": "eslint"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@google/genai": "^2.13.0",
    "lucide-react": "^1.26.0",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@ngrok/ngrok": "^1.4.1",
    "@tailwindcss/postcss": "^4",
    "concurrently": "^9.2.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
